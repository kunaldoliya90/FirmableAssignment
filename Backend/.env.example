# Backend settings; copy to Backend/.env or export as environment variables
FIRMABLE_ENV=local

FIRMABLE_API_PREFIX=/api/v1
FIRMABLE_LOG_LEVEL=INFO
FIRMABLE_LOG_JSON=false

FIRMABLE_DEFAULT_DATASET=FirmableAssignmentDataset

FIRMABLE_CORS_ORIGINS=["http://localhost:3000"]
# FIRMABLE_CORS_ORIGIN_REGEX=^https://firmable-[a-z0-9-]+\.vercel\.app$
FIRMABLE_FRONTEND_URL=http://localhost:3000

# Leave unset to use the threshold tuned by `orggraph-infer train` (learned_weights.json)
# FIRMABLE_INFERENCE__CONFIDENCE_THRESHOLD=0.63
FIRMABLE_INFERENCE__MAX_CANDIDATES=25
FIRMABLE_INFERENCE__COMPANY_CACHE_SIZE=64

FIRMABLE_ALLOW_DATASET_GENERATION=true
FIRMABLE_MAX_GENERATION_COMPANIES=500
FIRMABLE_JOB_WORKERS=2

# Offline only (Inference/scripts/llm_title_aliases.py); never needed by the running API
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5
# OPENAI_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>   (omit for api.openai.com)
